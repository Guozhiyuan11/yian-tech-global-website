---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { content, routeFor, type Locale, type PageId } from '../i18n/content';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  page?: PageId;
}

const { title, description = site.description, locale = 'en', page = 'home' } = Astro.props;
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
const t = content[locale];
const canonical = `https://${site.domain}${routeFor(locale, page)}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#111311" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={`https://${site.domain}${routeFor('en', page)}`} />
    <link rel="alternate" hreflang="es" href={`https://${site.domain}${routeFor('es', page)}`} />
    <link rel="alternate" hreflang="x-default" href={`https://${site.domain}${routeFor('en', page)}`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <Header locale={locale} page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} page={page} />

    <script>
      document.documentElement.classList.add('js');

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealItems = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));

      if (reducedMotion || !('IntersectionObserver' in window)) {
        revealItems.forEach((item) => item.classList.add('is-visible'));
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.12 },
        );
        revealItems.forEach((item) => revealObserver.observe(item));
      }
    </script>
  </body>
</html>
