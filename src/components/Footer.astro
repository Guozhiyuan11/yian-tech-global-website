---
import { site } from '../data/site';
import { content, routeFor, type Locale, type PageId } from '../i18n/content';

interface Props { locale?: Locale; page?: PageId }
const { locale = 'en', page = 'home' } = Astro.props;
const t = content[locale];
const home = routeFor(locale, 'home');
const products = routeFor(locale, 'products');
const sectionHref = (id: string) => page === 'home' ? `#${id}` : `${home}#${id}`;
---

<footer class="site-footer">
  <div class="shell site-footer__top">
    <a class="brand brand--footer" href={home} aria-label={`${site.name} home`}>
      <svg class="brand__mark" viewBox="0 0 42 42" aria-hidden="true"><path d="M5 5h9.5L21 17.5 27.5 5H37L25.2 26v11h-8.4V26L5 5Z"></path></svg>
      <span class="brand__name">YIAN <b>TECH GLOBAL</b></span>
    </a>
    <p>{t.footer.strapline[0]}<br />{t.footer.strapline[1]}</p>
  </div>
  <div class="shell site-footer__links">
    <div>
      <p>{t.footer.explore}</p>
      <a href={sectionHref('materials')}>{t.nav.materials}</a>
      <a href={products}>{t.nav.products}</a>
      <a href={sectionHref('capabilities')}>{t.nav.capabilities}</a>
      <a href={sectionHref('about')}>{t.nav.about}</a>
    </div>
    <div>
      <p>{t.footer.contact}</p>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.whatsappHref} target="_blank" rel="noreferrer">{site.whatsappDisplay}</a>
    </div>
    <div>
      <p>{t.footer.projectInfo}</p>
      {t.footer.projectLines.map((line) => <span>{line}</span>)}
    </div>
  </div>
  <div class="shell site-footer__bottom">
    <p>© {new Date().getFullYear()} {site.name}</p>
    <p>{t.footer.review}</p>
    <a href="#top">{t.footer.back} ↑</a>
  </div>
</footer>
