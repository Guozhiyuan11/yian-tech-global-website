---
import { site } from '../data/site';
import { catalogCategories, catalogProducts, localizeProduct } from '../data/catalog';
import { content, routeFor, type Locale } from '../i18n/content';

interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const t = content[locale].products;
const products = catalogProducts.map((product) => localizeProduct(product, locale));
const guides = [
  { ...t.guides[0], href: 'https://store.astm.org/a0554-16.html', source: 'ASTM A554' },
  { ...t.guides[1], href: 'https://rails.arcelormittal.com/products/transport-rails/mechanical-properties/', source: 'ArcelorMittal Rails' },
  { ...t.guides[2], href: 'https://www.crsi.org/crsi-standards/', source: 'CRSI Standards' },
  { ...t.guides[3], href: 'https://cision-ping.outokumpu.com/en/products/flat-products', source: 'Outokumpu' },
];
const subjectFor = (name: string) => encodeURIComponent(`${content[locale].contact.emailSubject}: ${name}`);
---

<section class="catalogue-hero" id="top">
  <div class="catalogue-hero__media" aria-hidden="true">
    <img src="/media/inventory/steel-02.webp" alt="" decoding="async" />
  </div>
  <div class="catalogue-hero__shade"></div>
  <div class="shell catalogue-hero__inner">
    <h1>{t.title}</h1>
    <div class="catalogue-hero__lower">
      <p>{t.intro}</p>
      <p>{t.productCount}</p>
    </div>
  </div>
</section>

<section class="catalogue section" id="catalogue">
  <div class="shell">
    <div class="catalogue-filter" data-catalogue-filter role="group" aria-label={t.filterLabel}>
      <button type="button" data-category="all" aria-pressed="true">{t.all}</button>
      {
        catalogCategories.map((category) => (
          <button type="button" data-category={category.key} aria-pressed="false">{category.label[locale]}</button>
        ))
      }
    </div>

    <p class="catalogue-count" aria-live="polite"><span data-catalogue-count>{products.length}</span> / {products.length}</p>

    <div class="catalogue-grid" data-catalogue-grid>
      {
        products.map((product) => (
          <article class="catalogue-card" data-product-card data-category={product.category}>
            <figure class="catalogue-card__media">
              <img src={product.image} alt={product.name} loading="lazy" decoding="async" />
              <span>{String(product.id).padStart(2, '0')}</span>
              {product.custom && <strong>{t.customBadge}</strong>}
            </figure>
            <div class="catalogue-card__body">
              <p class="catalogue-card__category">{product.categoryLabel}</p>
              <h2>{product.name}</h2>
              <dl>
                <div><dt>{t.process}</dt><dd>{product.process}</dd></div>
                <div><dt>{t.confidence}</dt><dd>{product.confidence === 'high' ? t.high : t.medium}</dd></div>
              </dl>
              <p>{product.detail}</p>
              <a class="text-link" href={`mailto:${site.email}?subject=${subjectFor(product.name)}`}>
                <span>{t.enquiry}</span><span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="catalogue-custom">
  <div class="shell catalogue-custom__inner" data-reveal>
    <div>
      <p>{locale === 'es' ? 'Fabricación a medida' : 'Custom fabrication'}</p>
      <h2>{t.customTitle}</h2>
    </div>
    <div>
      <p>{t.customCopy}</p>
      <a class="button button--dark" href={`mailto:${site.email}?subject=${encodeURIComponent(t.customCta)}`}>
        {t.customCta}<span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<section class="catalogue-guidance section">
  <div class="shell">
    <div class="section-heading section-heading--dark" data-reveal>
      <p class="section-heading__eyebrow"><span>02</span><span>{t.guidanceEyebrow}</span></p>
      <div class="section-heading__body">
        <h2>{t.guidanceTitle}</h2>
        <p>{t.guidanceCopy}</p>
      </div>
    </div>
    <div class="catalogue-guidance__grid">
      {
        guides.map((guide, index) => (
          <article data-reveal>
            <p>{String(index + 1).padStart(2, '0')}</p>
            <h3>{guide.title}</h3>
            <p>{guide.text}</p>
            <a href={guide.href} target="_blank" rel="noreferrer">
              <span>{t.sourceLabel}: {guide.source}</span><span aria-hidden="true">↗</span>
            </a>
          </article>
        ))
      }
    </div>
    <a class="text-link text-link--light catalogue-guidance__back" href={routeFor(locale, 'home')}>
      <span>{t.backHome}</span><span aria-hidden="true">←</span>
    </a>
  </div>
</section>

<script>
  const filter = document.querySelector<HTMLElement>('[data-catalogue-filter]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-product-card]'));
  const count = document.querySelector<HTMLElement>('[data-catalogue-count]');

  filter?.addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('button[data-category]');
    if (!button) return;
    const category = button.dataset.category;

    filter.querySelectorAll('button').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
    let visible = 0;
    cards.forEach((card) => {
      const show = category === 'all' || card.dataset.category === category;
      card.hidden = !show;
      if (show) visible += 1;
    });
    if (count) count.textContent = String(visible);
  });
</script>
