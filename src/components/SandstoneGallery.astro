---
import { sandstoneColours, sandstoneEnquiry, sandstoneAlbumRoute } from '../data/sandstone';
import type { Locale } from '../i18n/content';
interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const copy = {
  en: { eyebrow: 'Explore sandstone', title: 'Colour & character.', intro: 'Explore each colour through sample pieces, surface details, shaped products and application references. Open an album to browse the full selection.', reference: 'Photographs are a colour reference. Final colour and appearance are confirmed against the agreed sample.', photos: 'photographs', open: 'Explore album', customTitle: 'Made for your requirements.', customCopy: 'Choose a reference, then send dimensions, drawings, quantity and destination to discuss your custom order.', customCta: 'Discuss a custom order' },
  es: { eyebrow: 'Explore la arenisca', title: 'Color y carácter.', intro: 'Explore cada color con muestras, detalles de superficie, piezas y referencias de aplicación. Abra un álbum para ver la selección completa.', reference: 'Las fotografías sirven como referencia de color. El color y el aspecto finales se confirman con la muestra acordada.', photos: 'fotografías', open: 'Explorar álbum', customTitle: 'A la medida de sus requisitos.', customCopy: 'Elija una referencia y envíe dimensiones, planos, cantidad y destino para consultar su pedido a medida.', customCta: 'Consultar un pedido a medida' },
} as const;
const t = copy[locale];
---
<section class="sandstone-gallery" id="sandstone-colours" aria-labelledby="sandstone-gallery-title">
  <div class="shell">
    <header class="sandstone-gallery__header">
      <div><p class="sandstone-gallery__eyebrow">{t.eyebrow}</p><h2 id="sandstone-gallery-title">{t.title}</h2></div>
      <p class="sandstone-gallery__intro">{t.intro}</p>
    </header>
    <div class="sandstone-gallery__grid">
      {sandstoneColours.map((colour) => {
        const image = colour.images[0];
        return <a class="sandstone-colour" href={sandstoneAlbumRoute(locale, colour.id)} aria-label={`${colour.name[locale]} · ${colour.images.length} ${t.photos}`}>
          <div class="sandstone-colour__preview">
            <img src={image.src} srcset={image.srcSet} sizes="(min-width: 75rem) 20vw, (min-width: 48rem) 33vw, 50vw" width={image.width} height={image.height} alt={image.alt[locale]} loading="lazy" decoding="async" />
            <span class="sandstone-colour__count">{colour.images.length} {t.photos}</span>
          </div>
          <div class="sandstone-colour__strip" aria-hidden="true">
            {colour.images.slice(2, 5).map((photo) => <img src={photo.src} srcset={photo.srcSet} sizes="(min-width: 75rem) 7vw, (min-width: 48rem) 11vw, 17vw" width={photo.width} height={photo.height} alt="" loading="lazy" decoding="async" />)}
          </div>
          <div class="sandstone-colour__caption"><h3>{colour.name[locale]}</h3><p>{t.open}<span aria-hidden="true">↗</span></p></div>
        </a>;
      })}
    </div>
    <p class="sandstone-gallery__reference">{t.reference}</p>
    <div class="sandstone-gallery__custom"><h2>{t.customTitle}</h2><div><p>{t.customCopy}</p><a href={sandstoneEnquiry(locale)}>{t.customCta}<span aria-hidden="true">↗</span></a></div></div>
  </div>
</section>
<style>
  .sandstone-gallery { padding-block: clamp(4rem, 7vw, 8rem); background: #d8c6af; color: #30271f; }
  .sandstone-gallery__header { display: grid; grid-template-columns: 1.3fr .7fr; align-items: end; gap: 2rem 5rem; margin-bottom: 3.5rem; }
  .sandstone-gallery__eyebrow { margin-bottom: 1.5rem; font: .72rem/1.5 var(--mono); text-transform: uppercase; letter-spacing: .1em; }
  .sandstone-gallery__header h2 { font-size: clamp(2.6rem, 5vw, 6rem); line-height: 1.05; font-weight: 400; letter-spacing: -.055em; }
  .sandstone-gallery__intro { max-width: 43ch; line-height: 1.65; }
  .sandstone-gallery__grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 3.5rem 1.3rem; }
  .sandstone-colour { min-width: 0; display: block; }
  .sandstone-colour__preview { position: relative; overflow: hidden; aspect-ratio: 4 / 5; background: #c9b59c; }
  .sandstone-colour__preview img { width: 100%; height: 100%; object-fit: cover; transition: transform 400ms ease; }
  .sandstone-colour:hover .sandstone-colour__preview img { transform: scale(1.035); }
  .sandstone-colour__count { position: absolute; left: .6rem; bottom: .6rem; padding: .5rem .6rem; background: #eee5d9; font-size: .65rem; line-height: 1.4; }
  .sandstone-colour__strip { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .3rem; margin-top: .3rem; }
  .sandstone-colour__strip img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }
  .sandstone-colour__caption { padding-top: 1rem; }
  .sandstone-colour__caption h3 { font-size: clamp(1rem, 1.3vw, 1.35rem); font-weight: 500; letter-spacing: -.025em; line-height: 1.3; }
  .sandstone-colour__caption p { display: flex; justify-content: space-between; align-items: center; min-height: 2.75rem; margin-top: .35rem; font-size: .72rem; border-bottom: 1px solid #30271f40; }
  .sandstone-colour__caption p span { font-size: 1.2rem; }
  .sandstone-gallery a:focus-visible { outline: 2px solid #30271f; outline-offset: 5px; }
  .sandstone-gallery__reference { max-width: 80ch; margin-top: 2.5rem; font-size: .8rem; line-height: 1.65; }
  .sandstone-gallery__custom { display: grid; grid-template-columns: 1fr .7fr; gap: 2rem 5rem; margin-top: 5rem; padding-top: 3rem; border-top: 1px solid #30271f40; }
  .sandstone-gallery__custom h2 { max-width: 18ch; font-size: clamp(1.9rem, 3vw, 3.5rem); line-height: 1.15; font-weight: 400; letter-spacing: -.04em; }
  .sandstone-gallery__custom p { line-height: 1.65; max-width: 43ch; }
  .sandstone-gallery__custom a { display: inline-flex; align-items: center; gap: 2rem; min-height: 3rem; margin-top: 1.3rem; border-bottom: 1px solid; font-size: .85rem; }
  @media (max-width: 74.99rem) { .sandstone-gallery__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 47.99rem) { .sandstone-gallery__header, .sandstone-gallery__custom { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; } .sandstone-gallery__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.2rem .8rem; } .sandstone-gallery__intro { font-size: .9rem; } }
  @media (max-width: 23.99rem) { .sandstone-gallery__grid { grid-template-columns: minmax(0, 1fr); } }
  @media (prefers-reduced-motion: reduce) { .sandstone-colour__preview img { transition: none; } }
</style>
